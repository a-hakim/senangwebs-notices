{
  "name": "senangwebs-notices",
  "version": "2.0.2",
  "description": "Lightweight JavaScript library that replaces native browser dialogs (alert, confirm, prompt) with customizable, modern-looking notifications.",
  "main": "dist/swn.cjs",
  "module": "dist/swn.mjs",
  "types": "dist/swn.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/swn.d.mts", "default": "./dist/swn.mjs" },
      "require": { "types": "./dist/swn.d.cts", "default": "./dist/swn.cjs" }
    },
    "./style.css": "./dist/swn.min.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "style": "dist/swn.min.css",
  "files": [
    "dist/"
  ],
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "build": "webpack --mode production && node scripts/build-types.cjs",
    "dev": "webpack --watch",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:package": "node scripts/check-package.cjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "alert",
    "confirm",
    "prompt",
    "notification",
    "web",
    "customizable"
  ],
  "author": "a-hakim",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@playwright/test": "^1.63.0",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "jsdom": "^30.1.1",
    "mini-css-extract-plugin": "^2.10.2",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^6.0.1"
  }
}
