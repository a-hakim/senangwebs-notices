{
  "name": "senangwebs-notices",
  "version": "2.0.0",
  "description": "Lightweight JavaScript library that replaces native browser dialogs (alert, confirm, prompt) with customizable, modern-looking notifications.",
  "main": "dist/swn.min.js",
  "module": "dist/swn.js",
  "exports": {
    ".": {
      "import": "./dist/swn.js",
      "require": "./dist/swn.min.js"
    }
  },
  "style": "dist/swn.min.css",
  "files": [
    "dist/"
  ],
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "alert",
    "confirm",
    "prompt",
    "notification",
    "web",
    "customizable"
  ],
  "author": "a-hakim",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.25.8",
    "@babel/preset-env": "^7.25.8",
    "babel-loader": "^9.2.1",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "mini-css-extract-plugin": "^2.9.1",
    "style-loader": "^4.0.0",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  }
}
